.DS_Store

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# environment files
.env
.env.*
!env.example

node_modules
dist

#terraform
# State holds the DB passwords and app secrets in plain text.
*.tfstate
*.tfstate.*
crash.log

# Real values; commit the .example files only.
*.tfvars
!*.tfvars.example

.terraform/
# Commit .terraform.lock.hcl so provider versions stay pinned.
